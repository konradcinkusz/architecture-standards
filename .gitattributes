# A real .gitattributes — REPO-BASELINE.md §1 names the stock template with every
# rule commented out as decoration rather than configuration.

# Normalise line endings on the way in; check out LF everywhere. A CRLF sneaking
# into a shell script makes it fail with an unreadable "bad interpreter" error.
* text=auto eol=lf

*.sh    text eol=lf
*.mjs   text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf

*.png   binary
*.jpg   binary
*.pdf   binary

# The packaging layer is generated by scripts/build-marketplace.mjs. Collapsing it
# in diffs keeps a one-line catalog edit reviewable instead of burying it under the
# 63 regenerated files it produces. Still diffable with `git diff --text`.
plugins/**                      linguist-generated=true
.github/plugin/marketplace.json linguist-generated=true
.claude-plugin/marketplace.json linguist-generated=true
.github/agents/**               linguist-generated=true
catalog/versions.lock.json      linguist-generated=true

# GitHub counts this repository by its generator rather than its documents without
# this, and the documents are the point.
docs/**    linguist-documentation=true
