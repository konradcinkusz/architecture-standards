# REPO-BASELINE.md §1: per-IDE formatting wars are cheaper to prevent than to argue.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# The corpus is prose. Two trailing spaces are a markdown line break, so trimming
# them would silently reflow documents.
[*.md]
trim_trailing_whitespace = false
max_line_length = 90

[*.{json,yml,yaml}]
indent_size = 2

[*.{sh,mjs,js}]
indent_size = 2

[Makefile]
indent_style = tab
